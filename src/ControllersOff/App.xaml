<Application x:Class="ControllersOff.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type ui:ToggleSwitch}">
                <Setter Property="Focusable" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:ToggleSwitch}">
                            <Border x:Name="Track" Width="76" Height="30" CornerRadius="15"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <TextBlock x:Name="OffLabel" Text="{TemplateBinding OffContent}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Margin="0,0,12,0" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="OnLabel" Text="{TemplateBinding OnContent}"
                                               VerticalAlignment="Center" HorizontalAlignment="Left"
                                               Margin="12,0,0,0" FontSize="12" Visibility="Collapsed"
                                               Foreground="#FFFFFFFF" />
                                    <Ellipse x:Name="Knob" Width="20" Height="20"
                                             HorizontalAlignment="Left" VerticalAlignment="Center"
                                             Margin="4,0,0,0"
                                             Fill="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="0" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="#FF3F8CFF" />
                                    <Setter TargetName="Track" Property="BorderBrush" Value="#FF3F8CFF" />
                                    <Setter TargetName="Knob" Property="Fill" Value="#FFFFFFFF" />
                                    <Setter TargetName="Knob" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform X="46" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="OnLabel" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="OffLabel" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
