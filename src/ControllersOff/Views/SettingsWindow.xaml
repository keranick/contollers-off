<ui:FluentWindow x:Class="ControllersOff.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:ControllersOff"
                 Title="{Binding [Settings], Source={x:Static loc:Loc.Instance}}"
                 Width="460" SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" ShowMaximize="False" Title="{Binding [Settings], Source={x:Static loc:Loc.Instance}}" />

        <StackPanel Grid.Row="1" Margin="24,0,24,24">
        <TextBlock Text="{Binding [Theme], Source={x:Static loc:Loc.Instance}}" Margin="0,0,0,8" FontWeight="SemiBold" />
        <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch" SelectionChanged="OnThemeChanged" />

        <TextBlock Text="{Binding [DesignatedKeyboard], Source={x:Static loc:Loc.Instance}}" Margin="0,16,0,8" FontWeight="SemiBold" />
        <ComboBox x:Name="KeyboardBox" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="OnDesignatedChanged" />

        <TextBlock Text="{Binding [DesignatedMouse], Source={x:Static loc:Loc.Instance}}" Margin="0,16,0,8" FontWeight="SemiBold" />
        <ComboBox x:Name="MouseBox" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="OnDesignatedChanged" />

        <CheckBox x:Name="AutostartBox" Margin="0,20,0,0" Click="OnAutostartChanged"
                  Content="{Binding [StartWithWindows], Source={x:Static loc:Loc.Instance}}" />

        <TextBlock Text="{Binding [Language], Source={x:Static loc:Loc.Instance}}" Margin="0,20,0,8" FontWeight="SemiBold" />
        <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" SelectionChanged="OnLanguageChanged" />

        <ui:Button Content="{Binding [Done], Source={x:Static loc:Loc.Instance}}"
                   HorizontalAlignment="Right" Margin="0,24,0,0" Click="OnDoneClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
